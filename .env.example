# ==========================================
# Yojantra - Environment Configuration
# ==========================================

# Required Core Settings
# For Docker Compose internal networking:
DATABASE_URL=postgresql://schemematch:schemematch@db:5432/schemematch
# For local host development connecting to Docker PostgreSQL container:
# DATABASE_URL=postgresql://schemematch:schemematch@localhost:5433/schemematch

ENVIRONMENT=production
SECRET_KEY=change-this-to-a-secure-random-32-character-secret
APP_NAME=Yojantra
DEBUG=false
ALLOW_DEV_OTP=false
DEV_OTP_CODE=

# Firebase Admin SDK (Backend - Token Verification)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_CREDENTIALS_PATH=
FIREBASE_SERVICE_ACCOUNT_PATH=

# Firebase Client SDK (Frontend - Web Authentication)
VITE_API_URL=http://127.0.0.1:8001
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# External AI Services (Optional - Local rule engines active by default)
AI_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
PINECONE_API_KEY=
PINECONE_INDEX=schemes

# Graph Database & Caching
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=schemematch
REDIS_URL=redis://redis:6379/0

# External Gov & Banking APIs (Sandbox / Format-Validation mode active when empty)
# 1. UIDAI / Aadhaar (Production requires certified AUA/KUA license and endpoint)
UIDAI_API_URL=
UIDAI_LICENSE_KEY=
UIDAI_AUA_CODE=
UIDAI_SUB_AUA_CODE=
UIDAI_CERT_PATH=
AADHAAR_API_KEY=

# 2. PAN / Income Tax Verification (NSDL / Protean / UTIITSL)
PAN_GATEWAY_URL=
PAN_API_KEY=
PAN_SERVICE_PROVIDER=Protean

# 3. UDYAM / MSME Verification
UDYAM_GATEWAY_URL=
UDYAM_API_KEY=
UDYAM_CLIENT_ID=

# 4. DigiLocker (MeitY OAuth 2.0 Integration)
DIGILOCKER_CLIENT_ID=
DIGILOCKER_CLIENT_SECRET=
DIGILOCKER_API_BASE_URL=https://digilocker.meripehchan.gov.in

# 5. Core Banking Solution (CBS) / NPCI Gateway
CBS_GATEWAY_URL=
CBS_API_KEY=
CBS_AUTH_TYPE=bearer
BANKING_GATEWAY_URL=
BANKING_GATEWAY_API_KEY=
BANKING_GATEWAY_AUTH_TYPE=bearer
BANKING_GATEWAY_TIMEOUT_SECONDS=4.0
BANKING_GATEWAY_CERT_PATH=
BANKING_GATEWAY_KEY_PATH=
BANKING_GATEWAY_CA_PATH=

# 6. PFMS / Direct Benefit Transfer (DBT) Gateway & Inbound Webhooks
PFMS_GATEWAY_URL=
PFMS_API_KEY=
PFMS_AUTH_TYPE=bearer
PFMS_TIMEOUT_SECONDS=4.0
PFMS_WEBHOOK_SECRET=
BANKING_WEBHOOK_SECRET=
INTEGRATIONS_WEBHOOK_MAX_AGE_SECONDS=300

# 7. Official Gazette & Scheme Sync Gateway
GOV_SYNC_ENDPOINT_URL=
GOV_SYNC_API_KEY=

# Communications & Notifications (Twilio SMS / WhatsApp)
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_PHONE=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_AUTH_TOKEN=
WHATSAPP_API_KEY=
