# ==========================================
# SchemeMatch AI - Environment Configuration
# ==========================================

# Required Core Settings
DATABASE_URL=postgresql://schemematch:schemematch@db:5432/schemematch
# For local SQLite development, use:
# DATABASE_URL=sqlite:///./schemematch.db

SECRET_KEY=change-this-to-a-secure-random-32-character-secret
APP_NAME=SchemeMatch AI
DEBUG=false
ALLOW_DEV_OTP=false

# External AI Services (Optional - Falls back to deterministic local rule engines)
OPENAI_API_KEY=
GEMINI_API_KEY=
PINECONE_API_KEY=
PINECONE_INDEX=schemes

# Graph Database & Caching (Optional)
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=schemematch
REDIS_URL=redis://redis:6379/0

# Government & Verification APIs (Optional)
DIGILOCKER_CLIENT_ID=
DIGILOCKER_CLIENT_SECRET=
UDYAM_API_KEY=
AADHAAR_API_KEY=

# Communications & Notifications (Optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE=
WHATSAPP_API_KEY=

# Frontend Configuration
VITE_API_URL=http://localhost:8000
