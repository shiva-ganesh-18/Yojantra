# Yojantra Frontend Environment Configuration
VITE_API_URL=https://api.yojantra.gov.in

# Firebase Client Configuration (Firebase Console -> Project Settings -> General -> Web App)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional Firebase Web Push (FCM) VAPID Public Key (Firebase Console -> Cloud Messaging -> Web Push certificates)
VITE_FIREBASE_VAPID_KEY=

# Optional Firebase App Check (reCAPTCHA v3 or Enterprise Site Key)
VITE_FIREBASE_APP_CHECK_SITE_KEY=

# Optional Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX)
VITE_FIREBASE_MEASUREMENT_ID=
