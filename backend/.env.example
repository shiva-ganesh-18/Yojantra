# Yojantra Backend Environment Configuration

# Core Application & Security
ENVIRONMENT=production
DEBUG=False
SECRET_KEY=change-this-to-a-secure-random-32-character-secret
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://schemematch-ai-complete.vercel.app

# Database & Cache
DATABASE_URL=postgresql://schemematch:schemematch@db:5432/schemematch
REDIS_URL=redis://redis:6379/0

# Firebase Admin SDK (Server-Side Token Verification & App Check)
# Obtain from: Firebase Console -> Project Settings -> Service Accounts -> Generate New Private Key
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Handle newline escaping in FIREBASE_PRIVATE_KEY: replace newlines with \n
FIREBASE_PRIVATE_KEY=
# Or alternatively point to a local JSON file:
FIREBASE_CREDENTIALS_PATH=
FIREBASE_SERVICE_ACCOUNT_PATH=

# Firebase App Check Enforcement (Set to True in production after registering reCAPTCHA v3)
FIREBASE_APP_CHECK_ENFORCEMENT=False
FIREBASE_APP_CHECK_DEBUG_TOKEN=

# AI Engine
AI_PROVIDER=auto
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
PINECONE_API_KEY=
PINECONE_INDEX=schemes

# Optional Graph & Cache Extensions
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=schemematch

# External Gov & Banking APIs (Sandbox / Format-Validation mode active when empty)
# 1. UIDAI / Aadhaar (Production requires certified AUA/KUA license and endpoint)
UIDAI_API_URL=
UIDAI_LICENSE_KEY=
UIDAI_AUA_CODE=
UIDAI_SUB_AUA_CODE=
UIDAI_CERT_PATH=
AADHAAR_API_KEY=

# 2. PAN / Income Tax Verification (NSDL / Protean / UTIITSL)
PAN_GATEWAY_URL=
PAN_API_KEY=
PAN_SERVICE_PROVIDER=Protean

# 3. UDYAM / MSME Verification
UDYAM_GATEWAY_URL=
UDYAM_API_KEY=
UDYAM_CLIENT_ID=

# 4. DigiLocker (MeitY OAuth 2.0 Integration)
DIGILOCKER_CLIENT_ID=
DIGILOCKER_CLIENT_SECRET=
DIGILOCKER_API_BASE_URL=https://digilocker.meripehchan.gov.in

# 5. Core Banking Solution (CBS) / NPCI Gateway
CBS_GATEWAY_URL=
CBS_API_KEY=
CBS_AUTH_TYPE=bearer
BANKING_GATEWAY_URL=
BANKING_GATEWAY_API_KEY=
BANKING_GATEWAY_AUTH_TYPE=bearer
BANKING_GATEWAY_TIMEOUT_SECONDS=4.0
BANKING_GATEWAY_CERT_PATH=
BANKING_GATEWAY_KEY_PATH=
BANKING_GATEWAY_CA_PATH=

# 6. PFMS / Direct Benefit Transfer (DBT) Gateway & Inbound Webhooks
PFMS_GATEWAY_URL=
PFMS_API_KEY=
PFMS_AUTH_TYPE=bearer
PFMS_TIMEOUT_SECONDS=4.0
PFMS_WEBHOOK_SECRET=
BANKING_WEBHOOK_SECRET=
INTEGRATIONS_WEBHOOK_MAX_AGE_SECONDS=300

# 7. Official Gazette & Scheme Sync Gateway
GOV_SYNC_ENDPOINT_URL=
GOV_SYNC_API_KEY=

# Communications & Notifications (Optional)
# Twilio Auth Option 1: API Key Authentication (Recommended)
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_PHONE=
TWILIO_MESSAGING_SERVICE_SID=

# Twilio Auth Option 2: Auth Token (Legacy)
TWILIO_AUTH_TOKEN=

WHATSAPP_API_KEY=
